{
  "name": "dsh-oikonomia-eye",
  "version": "0.1.0",
  "type": "module",
  "description": "The Eye of Oikonomia: DSH plugin that injects the criteria a task's shape vocabulary recalls into the step about to run, and enforces the guarded ones at mid-turn checkpoints",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bingtang1019/dsh-oikonomia-eye.git"
  },
  "homepage": "https://github.com/Bingtang1019/dsh-oikonomia-eye#readme",
  "bugs": {
    "url": "https://github.com/Bingtang1019/dsh-oikonomia-eye/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "main": "./dsh/index.js",
  "types": "./dsh/index.d.ts",
  "exports": {
    ".": {
      "types": "./dsh/index.d.ts",
      "default": "./dsh/index.js"
    },
    "./invariant": {
      "types": "./dsh/invariant.d.ts",
      "default": "./dsh/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-rc.1 <0.1.4 || >=0.1.4-rc.1 <0.1.5 || >=0.1.5-rc.1 <0.1.6 || >=0.1.6-rc.1 <0.1.7 || >=0.1.7-rc.1 <0.1.8 || >=0.1.8 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-rc.1 <0.1.4 || >=0.1.4-rc.1 <0.1.5 || >=0.1.5-rc.1 <0.1.6 || >=0.1.6-rc.1 <0.1.7 || >=0.1.7-rc.1 <0.1.8 || >=0.1.8 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-rc.1 <0.1.4 || >=0.1.4-rc.1 <0.1.5 || >=0.1.5-rc.1 <0.1.6 || >=0.1.6-rc.1 <0.1.7 || >=0.1.7-rc.1 <0.1.8 || >=0.1.8 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-rc.1 <0.1.4 || >=0.1.4-rc.1 <0.1.5 || >=0.1.5-rc.1 <0.1.6 || >=0.1.6-rc.1 <0.1.7 || >=0.1.7-rc.1 <0.1.8 || >=0.1.8 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-rc.1 <0.1.4 || >=0.1.4-rc.1 <0.1.5 || >=0.1.5-rc.1 <0.1.6 || >=0.1.6-rc.1 <0.1.7 || >=0.1.7-rc.1 <0.1.8 || >=0.1.8 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-rc.1 <0.1.4 || >=0.1.4-rc.1 <0.1.5 || >=0.1.5-rc.1 <0.1.6 || >=0.1.6-rc.1 <0.1.7 || >=0.1.7-rc.1 <0.1.8 || >=0.1.8 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.1.3 || >=0.1.3-rc.1 <0.1.4 || >=0.1.4-rc.1 <0.1.5 || >=0.1.5-rc.1 <0.1.6 || >=0.1.6-rc.1 <0.1.7 || >=0.1.7-rc.1 <0.1.8 || >=0.1.8 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-loop": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-fs-local": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-loader-smoke": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-checkpoint-policy": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "dsh-oikonomia-eye": "link:.",
    "eslint": "^9.20.0",
    "semver": "^7.8.0",
    "tsup": "^8.3.6",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dsh",
    "cordis.patch.yml",
    "eval",
    "examples",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/inject-augments.mjs",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "entries:stamp": "node eval/stamp-entries.mjs",
    "entries:check": "node eval/stamp-entries.mjs --check",
    "peers:assert": "node scripts/check-peer-ranges.mjs",
    "check-pack": "node scripts/check-pack.mjs",
    "prepack": "node scripts/check-pack.mjs",
    "augment:check": "node scripts/inject-augments.mjs --check",
    "build:no-dts": "DSH_OIKONOMIA_EYE_NO_DTS=1 tsup"
  }
}
